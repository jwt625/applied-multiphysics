{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": false,
		"strict": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"types": ["node", "$app/types", "@webgpu/types"]
	},
	"include": ["src", "test", "scripts", "vite.config.ts"],
	"exclude": ["src/service-worker", "build", "node_modules", "test/tsl-probe/dist"]
}
