# Cloudflare Pages headers (DevLog-001 A13, Q6). Cross-origin isolation enables SharedArrayBuffer and threads.
# Every asset is self-hosted: no CDN, no web fonts, no third-party scripts.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # pages carry their CSP as a <meta> tag with the hashes of the inline bootstrap (vite.config.ts kit csp);
  # frame-ancestors only works as a header
  Content-Security-Policy: frame-ancestors 'none'

# HTML pages: no-transform stops zone-level edge injection (Bot Fight Mode JS detections, Web Analytics beacon),
# whose inline scripts the hashed meta CSP would block (DevLog-017 s.5). Value otherwise = the Pages default.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/workbench
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/play/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/_app/*
  # scripts and workers (a worker's CSP comes from its own response)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' https://api.anthropic.com; worker-src 'self'; img-src 'self' data: blob:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'

/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

/service-worker.js
  Cache-Control: no-cache
